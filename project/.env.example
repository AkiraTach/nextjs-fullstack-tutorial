# 本地开发（不用 Docker 时）复制为 .env.local
DATABASE_URL=postgres://shop:shop@localhost:5432/shop

# 至少 32 个字符的随机串：openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 站点地址（sitemap / Stripe 回跳使用）
SITE_URL=http://localhost:3000

# 种子数据里的管理员账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# 可选：不填则使用"模拟支付"页面；填了则走 Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
